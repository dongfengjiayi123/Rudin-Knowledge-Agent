# OpenAI-compatible /chat/completions endpoint. Do not include /chat/completions here.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=90
AGENT_MAX_ROUNDS=6
# local = direct shared tools; mcp = actual Agent -> MCP stdio tool calls
AGENT_TOOL_TRANSPORT=local
# Optional embeddings, separate provider is supported. Without these, use lexical retrieval.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# Optional paths, relative paths resolve against project root.
RUDIN_DB=data/knowledge.db
RUDIN_PDF=data/books/rudin.pdf
# HTTP MCP is bound to localhost; stdio is the default.
MCP_HOST=127.0.0.1
MCP_PORT=8001
